# VPS 对外访问端口
APP_PORT=8080

# Docker 数据卷名称；旧版升级时设置为 classpoint_data 可继续使用原数据
DATA_VOLUME_NAME=classorbit_data

# 使用 compose.deploy.yaml 时填写 GitHub Actions 发布的镜像地址
CLASSORBIT_IMAGE=ghcr.io/你的GitHub用户名/classorbit
CLASSORBIT_TAG=latest

# 国内服务器构建加速；海外服务器可改为官方源或留空使用 Dockerfile 默认值
GOPROXY=https://goproxy.cn,direct
NPM_REGISTRY=https://registry.npmmirror.com
ALPINE_MIRROR=https://mirrors.aliyun.com/alpine

# 可选：首次启动时自动创建教师账号；留空则首次打开后台时设置
TEACHER_USERNAME=
TEACHER_PASSWORD=

# KeySprint 班级名单同步接口的共享密钥；需与 KeySprint 的 CLASS_SYSTEM_TOKEN 相同
CLASS_SYSTEM_TOKEN=

# 影响考勤默认时间与 SQLite 本地时间
TZ=Asia/Shanghai

# 每日自动生成一致性数据库备份，默认保留 14 天（可设置 1-90）
AUTO_BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=14

# 仅当应用位于自己控制的反向代理之后时开启，用于限流识别真实客户端 IP
TRUST_PROXY_HEADERS=false
